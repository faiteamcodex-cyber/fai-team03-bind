# =============================================================================
# BIND System Configuration Template (.env.example)
# Copy this file to .env and configure for local development.
# Never commit real credentials or .env files to source control!
# =============================================================================

# AWS CLI Authentication & Region
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_PROFILE=fai-team03

# S3 Buckets & DynamoDB
DATA_BUCKET=fai-tce-team03-datasets
STATE_BUCKET=fai-tce-team03-app-state
LAND_RECORDS_TABLE=fai-tce-team03-land-records

# Bedrock Model Inference IDs
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BIND_PLANNER_MODEL_ID=apac.amazon.nova-micro-v1:0
BIND_TEACHER_VISION_MODEL_ID=apac.amazon.nova-lite-v1:0
BIND_STUDENT_VISION_MODEL_ID=apac.amazon.nova-lite-v1:0

# Vector Database (ChromaDB)
CHROMA_COLLECTION=advisory_store
CHROMA_PERSIST_DIR=./artifacts/chroma

# Application Budget & Runtime Settings
BIND_MAX_DOCKET_COST_USD=0.08
BIND_MAX_DOCKET_LATENCY_MS=12000
BIND_STUDENT_CONFIDENCE_THRESHOLD=0.65
BIND_USE_MOCKS=false
BIND_DEBUG=true
