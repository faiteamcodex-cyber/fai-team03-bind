# npm 10.x fails to resolve the React 18 + @types/react 18 peer set used by this
# project and aborts with: "Cannot read properties of null (reading 'edgesOut')".
# Removing this line makes `npm install` fail on that toolchain.
# Revisit once the team is on Node 22 / npm 11 (see README "Known constraints").
legacy-peer-deps=true
