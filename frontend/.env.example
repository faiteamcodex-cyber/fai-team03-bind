# ─────────────────────────────────────────────────────────────────────────────
# BIND frontend environment
# Copy to `.env.local` for local development. `.env.local` is git-ignored.
# NEVER hardcode these values in source (BIND rule 17).
# ─────────────────────────────────────────────────────────────────────────────

# BIND API Gateway base URL (ap-south-1), e.g.
# https://<api-id>.execute-api.ap-south-1.amazonaws.com/<stage>
# Ask Member 1 / Member 3 for the deployed value after SAM deploy (Phase 3).
VITE_API_BASE_URL=

# 'true'  → services/mockApi.ts (offline, labelled MOCK DATA in the UI)
# 'false' → live API Gateway via services/api.ts
VITE_USE_MOCK_API=true

# Dev-server port used for CORS allow-listing on the API Gateway / S3 side.
VITE_DEV_PORT=5173

# Comma-separated extra hostnames the dev/preview server may be reached through
# (container preview URLs, tunnels, LAN IPs). Vite already allows localhost.
# Example: VITE_ALLOWED_HOSTS=".e2b.app,.trycloudflare.com"
VITE_ALLOWED_HOSTS=
